# Copy to .env.local, or run scripts/setup-local.ps1 to generate it.
# Keep the default instance on a normal development machine; each instance owns a separate Docker volume.
DAYU_LOCAL_INSTANCE=dayu-local
DAYU_LOCAL_DB_PORT=13306
DAYU_LOCAL_HTTP_PORT=18080
# Existing absolute directories; leave blank when data is not available. No automatic scan.
DAYU_NETCDF_ROOT=
DAYU_WEBP_ROOT=
# Parent of colorbars/ or CPP_Colorbar/. Keep public image roots separate from NC.
DAYU_COLORBAR_ROOT=
