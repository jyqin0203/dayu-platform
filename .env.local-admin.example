# Copy to .env.local-admin and choose a local application password (12-64 ASCII characters recommended).
# Alternatively setup-local.ps1 generates a random password when .env.local-admin is absent.
# This is NOT the MariaDB account. Registration/bootstrap happens in initialize-local-products.ps1.
# Keep this dedicated email unchanged; use an unquoted password without an inline comment.
DAYU_LOCAL_ADMIN_EMAIL=local-admin@dayu.test
DAYU_LOCAL_ADMIN_PASSWORD=
