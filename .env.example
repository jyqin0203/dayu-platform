# Optional Qwen settings; never put an actual key in this example.
# start-local.ps1 loads only the listed Qwen keys. No model request is sent during startup.
DASHSCOPE_API_KEY=
DAYU_COPILOT_ENABLED=false
DAYU_COPILOT_QWEN_MODEL=qwen3.8-flash
DAYU_COPILOT_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
