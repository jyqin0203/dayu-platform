# Copy to .env.local-db and set a strong local-only password BEFORE first database startup.
# Alternatively setup-local.ps1 generates a random password when .env.local-db is absent.
# Changing this value later does not change an existing database user's password.
# Use one unquoted value with no inline comment; generated passwords use 64 hexadecimal characters.
DAYU_LOCAL_DB_PASSWORD=
